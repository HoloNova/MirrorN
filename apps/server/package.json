{
  "name": "@mirrorn/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts --port 8787",
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "esbuild src/index.ts --bundle --packages=external --platform=node --target=node24 --format=esm --outfile=dist/server.js && esbuild src/indexing/worker-entry.ts --bundle --packages=external --platform=node --target=node24 --format=esm --outfile=dist/index-worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@mirrorn/shared": "workspace:*",
    "bullmq": "5.61.0",
    "hono": "^4.6.14",
    "p-queue": "8.1.0",
    "parse5": "7.3.0",
    "semver": "7.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
