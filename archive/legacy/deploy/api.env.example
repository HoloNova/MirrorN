# MirrorN API 的运行环境（安装到 /etc/mirrorn/api.env，权限 0640 root:mirrorn）
#
# 这些值刻意写死在部署时生成的文件里，而不是仓库中：secret 不提交（PLAN 6.3）。

# 只监听本地，由 Caddy 反代（同域 /api）。要直接对外请显式改成 0.0.0.0 并自备 TLS。
MIRRORN_HOST=127.0.0.1
# 生产后端用 8788：dev 工作流把 8787 固定给开发后端（见 README），
# 两者分开意味着本机可以同时跑 dev 与生产服务，不会互相抢占。
MIRRORN_PORT=8788

# 数据目录：随部署复制到 /srv/mirrorn/api/data，包含 mirrors.json 与 ecosystems/。
MIRRORN_DATA_DIR=/srv/mirrorn/api/data

# 快照目录（systemd 单元里以 ReadWritePaths 放行）。
MIRRORN_SNAPSHOT_DIR=/var/lib/mirrorn

# 前面有本机 Caddy 作为可信代理：只有打开这一项才会解析 X-Forwarded-For。
# 直接对外暴露时必须保持 false，否则任何人都能伪造网络指纹。
MIRRORN_TRUSTED_PROXY=true

# 网络指纹的 HMAC secret。缺失时接口返回 available=false，这是刻意的降级。
MIRRORN_FINGERPRINT_SECRET=change-me

# 同步节奏（默认 15 分钟 / 45 分钟过期 / 10 秒抓取超时 / 4 MiB 响应上限）。
# MIRRORN_SYNC_ENABLED=true
# MIRRORN_SYNC_INTERVAL_MS=900000
# MIRRORN_SYNC_STALE_AFTER_MS=2700000
# MIRRORN_FETCH_TIMEOUT_MS=10000
# MIRRORN_MAX_RESPONSE_BYTES=4194304
