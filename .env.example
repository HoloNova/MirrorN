# 复制成 .env 后填写。.env 不会提交（见 .gitignore 的 `.env` / `.env.*`）。
#
# 网络指纹的 HMAC secret：不填也能启动，但 /api/net-fingerprint 会返回 available=false，
# 前端于是退回“网络变化监听 + 手动刷新”的策略。
# 生成一个：head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
MIRRORN_FINGERPRINT_SECRET=

# docker compose 映射到宿主机的端口（默认 8787；本机跑着 dev 时改成 8080 之类）。
MIRRORN_PUBLISHED_PORT=8787

# 以下是可选覆盖项，留空即使用默认值；含义见 docs/deployment.md。
# MIRRORN_SYNC_INTERVAL_MS=900000
# MIRRORN_SYNC_STALE_AFTER_MS=2700000
# MIRRORN_FETCH_TIMEOUT_MS=10000
# MIRRORN_MAX_RESPONSE_BYTES=4194304
