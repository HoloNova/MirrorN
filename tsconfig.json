{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"]
  },
  // 只检查新站源码、配置和正式工具脚本；资源数据由内容处理链校验。
  "include": [".astro/types.d.ts", "src/**/*", "config/**/*", "scripts/**/*.ts", "astro.config.ts"],
  "exclude": ["dist", "node_modules", "archive", ".local", ".pi", "content"]
}
