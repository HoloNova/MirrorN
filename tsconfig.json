{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["src/**/*", "config/**/*", "scripts/**/*.ts", "vite.config.ts", "react-router.config.ts", ".react-router/types/**/*"],
  "exclude": ["dist", "node_modules", "archive", ".local", ".pi", "content"]
}
