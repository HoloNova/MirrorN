---
interface Props {
  value: string;
  label: string;
  wrap?: boolean;
  disabled?: boolean;
}
const { value, label, wrap = false, disabled = false } = Astro.props;
---
<div class:list={['copy-block', { 'copy-block--wrap': wrap }]} data-copy-root data-copy-text={JSON.stringify(value)}>
  <div class="copy-block__toolbar">
    <span>{label}</span>
    <button type="button" data-copy-button hidden disabled={disabled} aria-label={`复制${label}`}>复制</button>
  </div>
  <pre tabindex="0" data-copy-value><code>{value}</code></pre>
  <span class="copy-block__feedback" data-copy-feedback aria-live="polite"></span>
</div>
<script>
  import '../../scripts/resource-copy';
</script>
