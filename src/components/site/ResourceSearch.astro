---
import { searchLimits } from '../../content/search/limits.ts';
import '../../styles/search.css';
interface Props { indexUrl: string; count: number }
const { indexUrl, count } = Astro.props;
---
<section class="resource-search" aria-label="资源搜索" data-resource-search data-search-index={indexUrl} data-search-count={count}>
  <form action="/" method="get" role="search" hidden data-search-form>
    <label for="resource-query">搜索资源</label>
    <div class="resource-search__controls">
      <svg class="resource-search__icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
      <input id="resource-query" name="q" type="search" role="combobox" maxlength={searchLimits.queryLength}
        placeholder="名称、别名、标签或拼音" autocomplete="off" spellcheck="false" enterkeyhint="go"
        aria-controls="resource-search-results" aria-expanded="false" aria-autocomplete="list"
        aria-describedby="resource-search-status" disabled data-search-input />
      <button type="button" class="resource-search__clear" hidden data-search-clear aria-label="清空搜索" title="清空搜索">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </form>
  <p id="resource-search-status" class="resource-search__status" role="status" aria-live="polite" aria-atomic="true" data-search-status>
    搜索尚未启用，可以直接浏览已收录目录。
  </p>
  <button type="button" hidden data-search-retry>重新加载搜索</button>
  <button type="button" hidden data-search-reload>刷新页面</button>
  <ol id="resource-search-results" role="listbox" aria-label="匹配的资源" hidden data-search-results></ol>
  <p class="resource-search__fallback"><a href="/resources/">浏览已收录分类</a></p>
  <noscript><p>搜索需要 JavaScript。已收录分类和资源正文无需 JavaScript 也可阅读。</p></noscript>
</section>
<script>
  import '../../scripts/search/controller.ts';
</script>
