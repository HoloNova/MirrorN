---
import type { DocumentHeading } from '../../content/parse/document-types';
interface Props { headings: readonly DocumentHeading[] }
const { headings } = Astro.props;
---

<aside class="page-toc" aria-label="本页章节目录" data-page-toc>
  <p class="page-toc__title" hidden data-toc-title>本页目录</p>
  <details open data-toc-disclosure>
    <summary data-toc-summary>本页目录</summary>
    <nav aria-label="本页目录" class="page-toc__links" data-toc-scroll>
      <ol>
        {headings.map((heading) => (
          <li style={`--toc-depth: ${heading.depth - 2}`}>
            <a href={`#${encodeURIComponent(heading.id)}`} data-toc-target={heading.id}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
</aside>

<script>
  import '../../scripts/page-toc';
</script>

<style>
  .page-toc { min-inline-size: 0; margin-block-end: var(--space-6); }
  details { padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-surface); }
  summary { min-block-size: var(--target-min-size); padding-block: var(--space-2); display: list-item; cursor: pointer; font-weight: var(--font-weight-medium); }
  summary[hidden] { display: none; }
  .page-toc__title { margin-block: 0 var(--space-3); font-weight: var(--font-weight-medium); }
  .page-toc__links { max-block-size: 35vh; overflow-y: auto; overscroll-behavior-y: contain; padding: calc(var(--space-1) + 2px); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; padding-inline-start: calc(var(--toc-depth) * 0.75rem); }
  a { display: block; min-block-size: var(--target-min-size); padding: var(--space-2) var(--space-3); border-inline-start: 2px solid var(--color-border); color: var(--color-text-muted); text-decoration: none; font-size: var(--font-size-ui); line-height: var(--line-height-ui); overflow-wrap: anywhere; }
  a:hover, a[aria-current='location'] { color: var(--color-link); }
  a[aria-current='location'] { border-inline-start-color: var(--color-link); background: var(--color-accent-soft); font-weight: var(--font-weight-medium); }
  @media (min-width: 1200px) {
    .page-toc { position: sticky; inset-block-start: var(--anchor-offset); margin-block-end: 0; }
    .page-toc__links { max-block-size: calc(100dvh - var(--anchor-offset) - var(--space-8)); }
    details { border: 0; padding: 0; }
  }
</style>
