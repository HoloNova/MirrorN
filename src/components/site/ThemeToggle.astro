---
// 紧凑图标控件：保留 system / light / dark，不用文字下拉框占据导航宽度。
// Holo 的主题开关提供了参考；本实现保留本站 Tokens 和原生脚本，不引入 React/动效运行时。
---

<div class="theme-control">
  <button
    class="theme-control__button"
    type="button"
    data-theme-toggle
    data-mode="system"
    aria-label="配色主题：跟随系统；点击切换为亮色"
    title="配色主题：跟随系统；点击切换为亮色"
  >
    <svg class="theme-icon theme-icon--system" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="13" rx="2" />
      <path d="M12 17v4m-4 0h8" />
    </svg>
    <svg class="theme-icon theme-icon--light" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </svg>
    <svg class="theme-icon theme-icon--dark" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 15A8.5 8.5 0 0 1 9 4a8.5 8.5 0 1 0 11 11Z" />
    </svg>
  </button>
  <span class="visually-hidden" aria-live="polite" data-theme-status></span>
</div>

<script>
  const storageKey = 'mirrorn-theme';
  const themes = ['system', 'light', 'dark'] as const;
  type Theme = (typeof themes)[number];
  const labels: Readonly<Record<Theme, string>> = { system: '跟随系统', light: '亮色', dark: '暗色' };
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const status = document.querySelector<HTMLElement>('[data-theme-status]');

  if (button) {
    const root = document.documentElement;
    const currentTheme = (): Theme =>
      root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : 'system';
    const nextTheme = (theme: Theme): Theme => themes[(themes.indexOf(theme) + 1) % themes.length]!;
    const updateButton = (theme: Theme): void => {
      const label = `配色主题：${labels[theme]}；点击切换为${labels[nextTheme(theme)]}`;
      button.dataset.mode = theme;
      button.setAttribute('aria-label', label);
      button.title = label;
    };

    updateButton(currentTheme());
    button.addEventListener('click', () => {
      const next = nextTheme(currentTheme());
      if (next === 'system') {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = next;
      }
      updateButton(next);
      if (status) status.textContent = `配色主题已切换为${labels[next]}`;

      try {
        window.localStorage.setItem(storageKey, next);
      } catch {
        // 存储不可用时仍允许本次页面切换，只是不跨刷新保存。
      }
    });
  }
</script>

<style>
  .theme-control__button {
    display: grid;
    place-items: center;
    inline-size: var(--target-min-size);
    block-size: var(--target-min-size);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-control__button:hover {
    background-color: var(--color-surface-muted);
    color: var(--color-link);
  }

  .theme-icon {
    display: none;
    inline-size: 20px;
    block-size: 20px;
  }

  [data-mode='system'] .theme-icon--system,
  [data-mode='light'] .theme-icon--light,
  [data-mode='dark'] .theme-icon--dark {
    display: block;
  }

  /* 无脚本时使用系统主题，不保留无法操作的按钮。 */
  :global(html:not(.has-js)) .theme-control {
    display: none;
  }
</style>
