---
import { fileURLToPath } from 'node:url';
import { root } from 'astro:config/server';
import { siteConfig } from '../../config/site.ts';
import SiteLayout from '../layouts/SiteLayout.astro';
import ResourceSearch from '../components/site/ResourceSearch.astro';
import { loadResourceRegistry } from '../content/registry/load.ts';
import { createSearchSnapshot } from '../content/search/snapshot.ts';
const registry = await loadResourceRegistry(fileURLToPath(root), { siteUrl: siteConfig.siteUrl });
const search = createSearchSnapshot(registry);
---

<SiteLayout description="MirrorN 是由贡献者通过 Git 共同维护的资源目录与文档站。">
  <div class="home">
    <header class="home__intro">
      <div>
        <h1>找到资源，读懂用法。</h1>
        <p class="page-lede">人工整理资源与使用文档，讲清来源、安装和适用条件。<br />由贡献者通过 Git 共同维护。</p>
      </div>
      <svg class="home__document" aria-hidden="true" focusable="false" viewBox="0 0 160 136" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M32 15h66l24 24v77H32zM98 15v24h24" />
        <path d="M20 31H12v97h98v-5M45 57h61M45 71h61M45 85h38M45 99h27" />
        <circle cx="111" cy="97" r="16" />
        <path d="m123 110 15 15" />
      </svg>
    </header>
    <ResourceSearch indexUrl={search.url} count={search.count} />
  </div>
</SiteLayout>
<style>
  .home { max-inline-size: 52rem; margin-inline: auto; padding-block-start: clamp(var(--space-5), 6vh, var(--space-8)); }
  .home__intro { display: grid; grid-template-columns: minmax(0, 1fr) 8rem; align-items: center; gap: var(--space-6); }
  h1 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.3; text-wrap: balance; }
  .page-lede { margin-block-end: 0; }
  .home__document { inline-size: 100%; color: var(--color-link); }
  @media (max-width: 767px) {
    .home { padding-block-start: var(--space-3); }
    .home__intro { grid-template-columns: minmax(0, 1fr); }
    .home__document { display: none; }
  }
</style>
