---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { fileURLToPath } from 'node:url';
import { root } from 'astro:config/server';
import { siteConfig } from '../../../config/site.ts';
import { contentCategories } from '../../content/categories';
import { loadResourceRegistry } from '../../content/registry/load.ts';
import { categoryAnchor } from '../../content/navigation';

// 公开文档已有内容，目录必须反映 Registry，不能继续显示写死的零。
const registry = await loadResourceRegistry(fileURLToPath(root), { siteUrl: siteConfig.siteUrl });
const collator = new Intl.Collator('zh-Hans-CN', { numeric: true, sensitivity: 'base' });
const categories = contentCategories.map((category) => ({
  ...category,
  resources: registry.resources.filter((resource) => resource.metadata.category === category.id).toSorted((left, right) =>
    collator.compare(left.metadata.sortKey ?? left.metadata.name, right.metadata.sortKey ?? right.metadata.name)
      || collator.compare(left.metadata.id, right.metadata.id)),
}));
---

<SiteLayout title="已收录" description="按八个固定分类浏览 MirrorN 收录的资源。">
  <section class="page-section" aria-labelledby="directory-title">
  <h1 id="directory-title">已收录</h1>
  <p class="page-lede">
    按类别浏览人工整理的资源。展开分类，选择名称，阅读获取与使用说明。
  </p>

  <div class="category-list">
    {
      categories.map((category) => (
        <details class="category" id={categoryAnchor(category.id)} data-category>
          <summary class="category__summary">
            <svg class="category__chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
            <span class="category__name">{category.name}</span>
            <span class="category__count">{category.resources.length} 项</span>
          </summary>
          {category.resources.length ? <ul class="category__resources">
            {category.resources.map((resource) => <li><a class="category__resource" href={`/resources/${resource.metadata.id}/`}>{resource.metadata.name}</a></li>)}
          </ul> : <p class="category__empty">尚未收录。</p>}
        </details>
      ))
    }
  </div>
  </section>
</SiteLayout>

<script>
  import '../../scripts/category-navigation';
</script>

<style>
  .category:target { border-color: var(--color-link); }
  .category-list {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .category {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-surface);
    background-color: var(--color-surface);
  }

  .category__summary {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) max-content;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--target-min-size);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    font-weight: var(--font-weight-medium);
  }

  .category__summary:hover { background-color: var(--color-surface-muted); }
  .category__summary::-webkit-details-marker { display: none; }
  .category__name { overflow-wrap: anywhere; }
  .category__chevron { inline-size: 20px; block-size: 20px; transition: transform var(--motion-fast); }
  .category[open] .category__chevron { transform: rotate(90deg); }
  .category[open] .category__summary { border-block-end: 1px solid var(--color-border); }
  .category__summary { border-radius: var(--radius-surface); }
  .category[open] .category__summary { border-end-start-radius: 0; border-end-end-radius: 0; }

  .category__count {
    color: var(--color-text-muted);
    font-size: var(--font-size-note);
    font-weight: var(--font-weight-regular);
  }

  .category__resources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    margin: 0;
  }

  .category__resource {
    display: flex;
    align-items: center;
    min-block-size: var(--target-min-size);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .category__resource:hover { border-color: var(--color-link); background: var(--color-accent-soft); }
  .category__resource { transition: background-color var(--motion-fast), border-color var(--motion-fast); }

  .category__empty {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    color: var(--color-text-muted);
  }
  @media (max-width: 767px) {
    .category__summary, .category__resources, .category__empty { padding-inline: var(--space-4); }
  }
</style>
