---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { fileURLToPath } from 'node:url';
import { root } from 'astro:config/server';
import { siteConfig } from '../../../config/site.ts';
import { contentCategories } from '../../content/categories';
import { loadResourceRegistry } from '../../content/registry/load.ts';

// 公开文档已有内容，目录必须反映 Registry，不能继续显示写死的零。
const registry = await loadResourceRegistry(fileURLToPath(root), { siteUrl: siteConfig.siteUrl });
const collator = new Intl.Collator('zh-Hans-CN', { numeric: true, sensitivity: 'base' });
const categories = contentCategories.map((category) => ({
  ...category,
  resources: registry.resources.filter((resource) => resource.metadata.category === category.id).toSorted((left, right) =>
    collator.compare(left.metadata.sortKey ?? left.metadata.name, right.metadata.sortKey ?? right.metadata.name)
      || collator.compare(left.metadata.id, right.metadata.id)),
}));
---

<SiteLayout title="已收录" description="按八个固定分类浏览 MirrorN 收录的资源。">
  <h1>已收录</h1>
  <p class="page-lede">
    资源按八个固定分类整理，分类默认折叠；展开后按名称排序，卡片只显示资源名称。本页不提供搜索。
  </p>

  <div class="category-list">
    {
      categories.map((category) => (
        <details class="category">
          <summary class="category__summary">
            <span class="category__name">{category.name}</span>
            <span class="category__count">{category.resources.length} 项</span>
          </summary>
          {category.resources.length ? <ul class="category__resources">
            {category.resources.map((resource) => <li><a class="category__resource" href={`/resources/${resource.metadata.id}/`}>{resource.metadata.name}</a></li>)}
          </ul> : <p class="category__empty">尚未收录。</p>}
        </details>
      ))
    }
  </div>
</SiteLayout>

<style>
  .category-list {
    display: grid;
    gap: var(--space-2);
    max-inline-size: 48rem;
  }

  .category {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-surface);
    background-color: var(--color-surface);
  }

  .category__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-block-size: var(--target-min-size);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-weight: var(--font-weight-medium);
  }

  .category__summary:hover {
    background-color: var(--color-surface-muted);
  }

  .category__count {
    color: var(--color-text-muted);
    font-size: var(--font-size-note);
    font-weight: var(--font-weight-regular);
  }

  .category__resources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    gap: var(--space-2);
    padding: 0 var(--space-4) var(--space-4);
    margin: 0;
  }

  .category__resource {
    display: flex;
    align-items: center;
    min-block-size: var(--target-min-size);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .category__resource:hover { background: var(--color-surface-muted); }

  .category__empty {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
    color: var(--color-text-muted);
  }
</style>
