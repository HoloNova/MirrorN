---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { contentCategories } from '../../content/categories';

// P1 还没有资源注册表（P2 起实现），八个分类真实为空，所以统一显示 0；
// P4 接入注册表后这里改为读取实际公开资源数量。
const resourceCount = 0;
---

<SiteLayout title="已收录" description="按八个固定分类浏览 MirrorN 收录的资源。">
  <h1>已收录</h1>
  <p class="page-lede">
    资源按八个固定分类整理，分类默认折叠；展开后按名称排序，卡片只显示资源名称。本页不提供搜索。
  </p>

  <div class="category-list">
    {
      contentCategories.map((category) => (
        <details class="category">
          <summary class="category__summary">
            <span class="category__name">{category.name}</span>
            <span class="category__count">{resourceCount} 项</span>
          </summary>
          <p class="category__empty">尚未收录。</p>
        </details>
      ))
    }
  </div>
</SiteLayout>

<style>
  .category-list {
    display: grid;
    gap: var(--space-2);
    max-inline-size: 48rem;
  }

  .category {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-surface);
    background-color: var(--color-surface);
  }

  .category__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-block-size: var(--target-min-size);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-weight: var(--font-weight-medium);
  }

  .category__summary:hover {
    background-color: var(--color-surface-muted);
  }

  .category__count {
    color: var(--color-text-muted);
    font-size: var(--font-size-note);
    font-weight: var(--font-weight-regular);
  }

  .category__empty {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
    color: var(--color-text-muted);
  }
</style>
