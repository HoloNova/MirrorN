---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

interface Props {
  title: string;
  summary: string;
}

/**
 * 资源详情路由边界。
 *
 * 为什么返回空数组：资源注册表（P2）与页面生成（P4）尚未实现，这里既不能凭目录名
 * 编造页面，也不能把未校验的内容渲染成公开页面。空 getStaticPaths 让 /resources/<id>/
 * 这一层路径在静态构建中存在但不产出任何页面，访问时由 404 处理。
 * P4 改为从注册表读取公开资源并生成路径。
 */
export function getStaticPaths(): Array<{ params: { id: string }; props: Props }> {
  return [];
}

const { title, summary } = Astro.props;
---

<ResourceLayout title={title} summary={summary} />
