---
import { fileURLToPath } from 'node:url';
import { root } from 'astro:config/server';
import { siteConfig } from '../../../config/site.ts';
import ResourceLayout from '../../layouts/ResourceLayout.astro';
import ResourceDocument from '../../components/resource/ResourceDocument.astro';
import ResourceMetadata from '../../components/resource/ResourceMetadata.astro';
import Notice from '../../components/resource/Notice.astro';
import { contentCategories } from '../../content/categories';
import { categoryHref, resourceEditUrl } from '../../content/navigation';
import { resolveDocumentUrl } from '../../content/resolve/assets.ts';
import { loadResourceRegistry } from '../../content/registry/load.ts';
import type { PublishedResource, ResourceRegistry } from '../../content/registry/types.ts';

interface Props { resource: PublishedResource; registry: ResourceRegistry }
/** 只生成已校验公开文档；正文、元信息与目录沿用同一 Registry。 */
export async function getStaticPaths() {
  const registry = await loadResourceRegistry(fileURLToPath(root), { siteUrl: siteConfig.siteUrl });
  return registry.resources.map((resource) => ({ params: { id: resource.metadata.id }, props: { resource, registry } satisfies Props }));
}
const { resource, registry } = Astro.props;
const metadata = resource.metadata;
const category = contentCategories.find((entry) => entry.id === metadata.category)!;
const returnHref = categoryHref(metadata.category);
const editUrl = resourceEditUrl(siteConfig, metadata.id);
const contributionPage = registry.get('mirrorn-contributing');
---
<ResourceLayout title={metadata.name} summary={metadata.summary} headings={resource.document.headings}
  seoTitle={metadata.seo?.title} seoDescription={metadata.seo?.description}
  seoImage={metadata.seo?.image ? resolveDocumentUrl(resource, metadata.seo.image) : undefined}>
  <ResourceMetadata slot="metadata" resource={resource} categoryName={category.name} />
  {metadata.status !== 'active' && <Notice type="warning" title={metadata.status === 'deprecated' ? '资源已废弃' : '资源仅作存档'}><p>{metadata.statusReason}</p></Notice>}
  <ResourceDocument resource={resource} registry={registry} />
  <footer slot="footer" class="resource-footer">
    <nav aria-label="文章操作">
      <a class="page-action" href={returnHref}>返回{category.name}</a>
      {editUrl && <a class="page-action" href={editUrl} rel="noopener">编辑此页（GitHub）</a>}
      {contributionPage && contributionPage.metadata.id !== metadata.id && <a class="page-action" href={`/resources/${contributionPage.metadata.id}/`}>贡献指南</a>}
    </nav>
    {editUrl && <p>在 GitHub 完成修改后主动提交 PR；同一项修改继续更新同一个 PR。本站不会自动提 PR。</p>}
    <p>除另有标注，本站原创文档采用 <a href="/licenses/cc-by-4.0.txt">CC BY 4.0</a>，转载请保留作者与原文链接、注明改动；原创程序示例采用 MIT，所介绍资源与附件按各自许可。</p>
  </footer>
</ResourceLayout>
<style>
  .resource-footer { margin-block-start: var(--space-7); padding-block-start: var(--space-5); border-block-start: 1px solid var(--color-border); }
  .resource-footer nav { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); }
  .resource-footer p { margin-block-start: var(--space-3); color: var(--color-text-muted); font-size: var(--font-size-note); }
</style>
