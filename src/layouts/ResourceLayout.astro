---
import SiteLayout from './SiteLayout.astro';
import PageToc from '../components/site/PageToc.astro';
import type { DocumentHeading } from '../content/parse/document-types';

interface Props {
  /** 页面唯一 h1；正文标题与 TOC 沿用 Registry 的锚点。 */
  title: string;
  summary?: string;
  headings?: readonly DocumentHeading[];
  seoTitle?: string;
  seoDescription?: string;
  seoImage?: string;
}
const { title, summary, headings = [], seoTitle, seoDescription, seoImage } = Astro.props;
const hasToc = headings.length >= 2;
---
<SiteLayout title={seoTitle ?? title} description={seoDescription ?? summary} image={seoImage} pageType="article">
  <div class:list={['resource-frame', { 'resource-frame--with-toc': hasToc }]}>
    {hasToc && <PageToc headings={headings} />}
    <article class="resource" data-resource-article>
      <header class="resource__header">
        <h1>{title}</h1>
        {summary && <p class="resource__summary">{summary}</p>}
        <slot name="metadata" />
      </header>
      <div class="prose"><slot /></div>
      <slot name="footer" />
    </article>
  </div>
</SiteLayout>
<style>
  .resource-frame { max-inline-size: var(--layout-reading-width); margin-inline: auto; }
  .resource { min-inline-size: 0; overflow-wrap: anywhere; }
  .resource__header { margin-block-end: var(--space-6); }
  .resource__summary { max-inline-size: var(--layout-reading-width); color: var(--color-text-muted); font-size: var(--font-size-lede); }
  h1 { text-wrap: balance; }
  @media (min-width: 1200px) {
    .resource-frame--with-toc {
      display: grid;
      grid-template-columns: 14rem minmax(0, var(--layout-reading-width));
      gap: var(--space-6);
      align-items: start;
      max-inline-size: calc(14rem + var(--space-6) + var(--layout-reading-width));
    }
  }
</style>
